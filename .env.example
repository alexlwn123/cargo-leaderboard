# Vercel provisions this through its Neon integration.
DATABASE_URL=
# Generate a random value; required for production and preview deployments.
RATE_LIMIT_SALT=
# Canonical browser origin; never derive OAuth callbacks from request headers.
APP_ORIGIN=https://cargo-leaderboard.vercel.app
# GitHub OAuth app: callback URL must be APP_ORIGIN/auth/callback. No repository scopes.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate at least 32 random characters. Rotation invalidates all logins.
AUTH_SECRET=
